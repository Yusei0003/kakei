# LINE Developers > Messaging APIチャネル の設定画面から取得
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase プロジェクトの Settings > API から取得
# SUPABASE_SERVICE_ROLE_KEY は強い権限を持つため、絶対にクライアント側コードや公開リポジトリに含めないこと
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Console で Vision API を有効化して発行したAPIキー（無料枠: 月1,000件）
# 未設定の間はレシート画像のOCRをスキップし、案内メッセージを返す
GOOGLE_CLOUD_VISION_API_KEY=

# ダッシュボード(/)を保護するBasic認証。実際の収支データを表示するため、
# 本番では必ず設定すること。未設定の間はローカル開発用に認証をスキップする
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# 単一ユーザー運用の前提。未設定ならtransactionsテーブルに最初に現れた
# LINEユーザーIDを自動的に「本人」とみなすため、通常は設定不要
DASHBOARD_LINE_USER_ID=

# 毎月1日 09:00 JST に「明細を送ってください」とLINEにリマインドするCron用の認証。
# 任意の乱数文字列を設定し、Vercel側にも同じ値を設定すること
# （Vercelが自動でこの値をCron実行時のAuthorizationヘッダーに使う）
CRON_SECRET=
